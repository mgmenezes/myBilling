{
  "name": "mybilling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "test:unit": "vitest run --project domain --coverage",
    "test:integration": "vitest run --project integration",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.0",
    "fast-check": "^4.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
