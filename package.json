{
  "name": "mybilling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "test:unit": "echo \"test:unit: configurado em T3 (Vitest)\" && exit 0",
