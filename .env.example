# Copie para .env.local e preencha com valores reais. Nunca commite .env.local.

# String de conexão com o Postgres (AD-002, DADO-02).
# O Docker local publica a 5433, e não a 5432, para não colidir com um Postgres
# já instalado na máquina — veja docker-compose.yml.
DATABASE_URL=postgres://mybilling:mybilling@localhost:5433/mybilling

# Gerar com: openssl rand -base64 32
AUTH_SECRET=troque-por-openssl-rand-base64-32

# Credenciais do OAuth do Google (Auth.js v5)
AUTH_GOOGLE_ID=troque-pelo-client-id-do-google
AUTH_GOOGLE_SECRET=troque-pelo-client-secret-do-google

# Lista de e-mails autorizados a entrar, separados por vírgula (AD-007)
EMAILS_PERMITIDOS=pessoa-a@example.com,pessoa-b@example.com

# Habilita o provider de credenciais usado pelo teste de ponta a ponta.
# NUNCA defina esta variável em produção: o boot da aplicação lança se ela
# estiver presente com NODE_ENV=production. Ela só tem efeito com NODE_ENV=test,
# e mesmo assim o e-mail continua passando pela allowlist acima.
# AUTH_PROVIDER_DE_TESTE=1
