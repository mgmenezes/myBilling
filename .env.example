# Copie para .env.local e preencha com valores reais. Nunca commite .env.local.

# String de conexão com o Postgres (AD-002, DADO-02)
DATABASE_URL=postgres://usuario:senha@localhost:5432/mybilling

# Gerar com: openssl rand -base64 32
AUTH_SECRET=troque-por-openssl-rand-base64-32

# Credenciais do OAuth do Google (Auth.js v5)
AUTH_GOOGLE_ID=troque-pelo-client-id-do-google
AUTH_GOOGLE_SECRET=troque-pelo-client-secret-do-google

# Lista de e-mails autorizados a entrar, separados por vírgula (AD-007)
EMAILS_PERMITIDOS=pessoa-a@example.com,pessoa-b@example.com
